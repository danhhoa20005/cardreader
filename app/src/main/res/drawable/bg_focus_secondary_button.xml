<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#151E30" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#23304A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#334155" />
            <corners android:radius="10dp" />
            <stroke android:width="2.5dp" android:color="@color/border_focus_ring" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_elevated" />
            <corners android:radius="10dp" />
            <stroke android:width="2.5dp" android:color="@color/border_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
        </shape>
    </item>
</selector>
