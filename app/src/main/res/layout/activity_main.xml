<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#121824">

    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="32dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hệ Thống Điểm Danh Học Sinh"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- Warning banner if no data exists -->
        <TextView
            android:id="@+id/tvWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Cảnh báo: Chưa có thông tin đăng nhập. Vui lòng nhập Tên đăng nhập và Mật khẩu."
            android:textColor="#FCA5A5"
            android:textSize="13sp"
            android:background="#451A03"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Countdown / status message -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#93C5FD"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên đăng nhập"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nhập tên đăng nhập"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:inputType="text"
            android:maxLines="1"
            android:background="#0F172A"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="username" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mật khẩu"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nhập mật khẩu"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:maxLines="1"
            android:background="#0F172A"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="24dp"
            android:autofillHints="password" />

        <Button
            android:id="@+id/btnSaveAndConnect"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Lưu và Kết Nối"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#334155"
            android:textColor="#F8FAFC" />

    </LinearLayout>

</LinearLayout>
